{
  "name": "@super-system/cli",
  "version": "0.1.0-beta.8",
  "description": "Initialize, customize, and audit a consistent design system in React projects.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "super-system": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trondulseth/super-system.git",
    "directory": "packages/cli"
  },
  "files": ["dist"],
