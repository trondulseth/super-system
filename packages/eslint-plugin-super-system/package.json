{
  "name": "eslint-plugin-super-system",
  "version": "0.1.0-beta.19",
  "description": "ESLint rules aligned with Super System CLI audit.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trondulseth/super-system.git",
    "directory": "packages/eslint-plugin-super-system"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "dependencies": {
    "@super-system/rules": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
